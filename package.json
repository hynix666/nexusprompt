{
  "name": "nexusprompt",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "contracts",
    "core",
    "application",
    "adapters/*",
    "shells/*"
  ],
  "scripts": {
    "verify": "npm run check:hygiene && npm run lint:boundaries && npm run typecheck && npm run verify:sources && npm run check:counts && npm run check:plan && npm run check:citations && npm run check:catalog && npm run check:xsd && npm run check:depth && npm run check:stages && npm run check:sizing && npm run check:anchor && npm run check:matrix && npm run check:manifest-spec && npm run check:truth && npm run check:fence-explanation && npm run check:hash && npm run check:fingerprint && npm run check:examples && npm run eval && npm run eval:compare && npm run eval:adversarial && npm run eval:pipeline && npm run eval:anchor && npm run test && npm run differential",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "check:plan": "node scripts/check-plan.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "check:citations:online": "node scripts/check-citations-online.mjs",
    "import:catalog": "node scripts/import-catalog.mjs",
    "check:catalog": "node scripts/import-catalog.mjs --check",
    "check:xsd": "node scripts/check-xsd.mjs",
    "verify:sources": "node scripts/verify-sources.mjs",
    "test": "vitest run",
    "test:core": "vitest run --project core",
    "typecheck": "tsc --noEmit",
    "test:app": "vitest run --project application",
    "lint:sources": "node scripts/verify-sources.mjs",
    "cli": "tsx shells/cli/src/index.ts",
    "api": "tsx shells/api/src/index.ts",
    "test:shells": "vitest run --project shells",
    "differential": "tsx scripts/differential.ts",
    "check:depth": "node scripts/check-depth-budget.mjs",
    "eval": "tsx scripts/run-eval.ts",
    "eval:compare": "tsx scripts/run-eval.ts --compare",
    "eval:adversarial": "tsx scripts/run-adversarial.ts",
    "check:stages": "node scripts/check-stages.mjs",
    "check:corpus": "node scripts/check-corpus.mjs",
    "check:counts": "node scripts/check-counts.mjs",
    "check:fingerprint": "node scripts/check-fingerprint.mjs",
    "check:sizing": "tsx scripts/check-sizing.ts",
    "docs:matrix": "node scripts/generate-capability-matrix.mjs",
    "check:matrix": "node scripts/generate-capability-matrix.mjs --check",
    "build:anchor": "tsx scripts/build-anchor.ts",
    "check:anchor": "tsx scripts/build-anchor.ts --check",
    "eval:anchor": "tsx scripts/run-anchor.ts",
    "eval:pipeline": "tsx scripts/run-pipeline-eval.ts",
    "compare:models": "tsx scripts/compare-models.mjs",
    "docs:manifest-spec": "node scripts/generate-manifest-spec.mjs",
    "check:manifest-spec": "node scripts/generate-manifest-spec.mjs --check",
    "docs:truth": "tsx scripts/check-truth-boundary.ts",
    "check:truth": "tsx scripts/check-truth-boundary.ts --check",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "docs:fence-explanation": "tsx scripts/generate-fence-explanation-data.ts",
    "check:fence-explanation": "tsx scripts/generate-fence-explanation-data.ts --check",
    "build:hash": "node scripts/build-hash.mjs --write",
    "check:hash": "node scripts/build-hash.mjs --check",
    "doctor": "tsx scripts/doctor.ts",
    "example:lint": "tsx scripts/examples.ts --lint",
    "example:pipeline": "tsx scripts/examples.ts --pipeline",
    "example:refuse": "tsx scripts/examples.ts --refuse",
    "check:examples": "tsx scripts/examples.ts --check",
    "docs:examples": "tsx scripts/examples.ts --write"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fast-check": "^4.3.0",
    "libxml2-wasm": "^0.7.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
